function menuInfo(){$('#pn').textContent=S.name;$('#lvl').textContent='Nv '+lv();$('#co').textContent='🧶 '+S.coins+'  💎 '+S.cr;const a=60*(lv()-1)**2,b=60*lv()**2;$('#xb').style.width=(S.xp-a)/(b-a)*100+'%'}
function home(){state='menu';RS=[];if(trk){sc.remove(trk);trk=null}OB=[];mnu.visible=true;sc.background=new THREE.Color(0xbfe9ff);sc.fog=new THREE.Fog(0xbfe9ff,30,90);cam.fov=55;cam.updateProjectionMatrix();pvSet(S.eq);menuInfo();show('menu')}
const TT={maps:'Mapas',custom:'Personalizar',shop:'Loja',ach:'Conquistas',quests:'Missões',set:'Definições'};
function page(n){state='menu';$('#pt').textContent=TT[n];PGS[n]();show('pg')}
const cur=()=>`<p>🧶 ${S.coins} · 💎 ${S.cr}</p>`;
function items(own){const cat={s:'Skins',a:'Acessórios',t:'Rastos'};let h='';
 for(const t of 'sat'){const l=Object.values(IT).filter(i=>i.t==t&&!!S.own[i.id]==own);if(!l.length)continue;
  h+=`<h3>${cat[t]}</h3><div class="gr">`+l.map(i=>{const eq=S.eq[t]==i.id;return `<div class="cdz" style="--rc:${RC[i.r]}" data-a="pv" data-v="${i.id}"><i class="sw" style="background:${gd(i.c)}"></i><b>${i.n}</b><small style="color:${RC[i.r]}">${RN[i.r]}</small>${own?`<button class="${eq?'o':'g'}" data-a="eq" data-v="${i.id}">${eq?'✔ Equipado':'Equipar'}</button>`:`<button data-a="buy" data-v="${i.id}">${i.p} ${i.u?'💎':'🧶'}</button>`}</div>`}).join('')+'</div>'}
 return h||'<p>Não há nada aqui por agora.</p>'}
const PGS={
 maps(){$('#pb').innerHTML='<h3>Mapa</h3><div class="gr">'+MAPS.map((m,i)=>{const lk=lv()<m.lv;return `<button class="g${S.map==i?' sel':''}" ${lk?'disabled':''} data-a="map" data-v="${i}">${lk?'🔒 Nv '+m.lv+' · ':''}${m.n}</button>`}).join('')+'</div><h3>Modo</h3><div class="gr">'+['Corrida rápida','Contra-relógio'].map((n,i)=>`<button class="g${S.mode==i?' sel':''}" data-a="mode" data-v="${i}">${n}</button>`).join('')+`</div><p>Melhor tempo: ${S.best[S.map]?fmt(S.best[S.map]):'—'}</p><button class="o" data-a="play">▶ Jogar</button>`},
 custom(){$('#pb').innerHTML=cur()+items(true)},
 shop(){$('#pb').innerHTML=cur()+items(false)},
 ach(){$('#pb').innerHTML=AC.map((a,i)=>{const v=Math.min(a[3],a[2]());return `<div class="cdz" style="cursor:default;--rc:${S.ach[i]?'#ffb020':'#8884'}"><b>${S.ach[i]?'🏆':'🔒'} ${a[0]}</b><small>${a[1]}</small><div class="bar"><i style="width:${v/a[3]*100}%"></i></div><small>${v}/${a[3]} · ${a[4]}🧶${a[5]?' '+a[5]+'💎':''}</small></div>`}).join('')},
 quests(){qs();$('#pb').innerHTML=QS.map(q=>{const[p,k,t,g,cc,u]=q,v=Math.min(g,S.q[p].v[k]||0),dn=S.q[p].c[k];return `<div class="cdz" style="cursor:default"><b>${p=='d'?'Diária':'Semanal'}: ${t}</b><div class="bar"><i style="width:${v/g*100}%"></i></div><small>${v}/${g} · ${cc}🧶${u?' '+u+'💎':''}</small>${dn?'<small>✔ Recebida</small>':`<button class="o" ${v<g?'disabled':''} data-a="claim" data-v="${p}${k}">Receber</button>`}</div>`}).join('')},
 set(){const t=(k,n)=>`<button class="${S.set[k]?'o':'g'}" data-a="tg" data-v="${k}">${n}: ${S.set[k]?'ligado':'desligado'}</button>`;
  $('#pb').innerHTML=`<label>Nome<input data-n maxlength="12" value="${S.name}"></label>`+t('mus','Música')+t('sfx','Efeitos sonoros')+t('vib','Vibração')+t('cam','Movimento da câmara')+'<h3>Qualidade gráfica</h3><div class="gr">'+['Baixa','Média','Alta'].map((n,i)=>`<button class="${S.set.q==i?'o':'g'}" data-a="ql" data-v="${i}">${n}</button>`).join('')+'</div><button data-a="reset">Apagar progresso</button>'}};
let cb=null;function ask(t,f){cb=f;$('#mt').textContent=t;$('#md').classList.add('on')}
const act={
 play:start,menu(){home()},pg:page,
 map(i){S.map=+i;save();PGS.maps()},mode(i){S.mode=+i;save();PGS.maps()},
 pv(id){const e=Object.assign({},S.eq);e[IT[id].t]=id;pvSet(e)},
 eq(id){S.eq[IT[id].t]=id;save();pvSet(S.eq);PGS.custom()},
 buy(id){const i=IT[id],k=i.u?'cr':'coins';if(S[k]<i.p)return toast('Não tens '+(i.u?'cristais':'moedas')+' suficientes');
  ask(`Comprar ${i.n} por ${i.p} ${i.u?'💎':'🧶'}?`,()=>{S[k]-=i.p;S.own[id]=1;S.eq[i.t]=id;save();chk();pvSet(S.eq);PGS.shop();toast('Comprado: '+i.n)})},
 claim(v){qs();const p=v[0],k=v.slice(1),q=QS.find(x=>x[0]==p&&x[1]==k);if((S.q[p].v[k]||0)>=q[3]&&!S.q[p].c[k]){S.q[p].c[k]=1;pay(q[4],q[5]);toast('+'+q[4]+'🧶'+(q[5]?' +'+q[5]+'💎':''));save();PGS.quests()}},
 tg(k){S.set[k]=S.set[k]?0:1;save();PGS.set()},ql(v){S.set.q=+v;save();rs();PGS.set()},
 reset(){ask('Apagar todo o progresso? Não é possível desfazer.',()=>{S=D();save();home()})},
 ok(){$('#md').classList.remove('on');const f=cb;cb=null;f&&f()},no(){$('#md').classList.remove('on');cb=null}};
document.addEventListener('click',e=>{const t=e.target.closest('[data-a]');if(!t||t.disabled)return;au();tone(620,.07,'triangle',.08);act[t.dataset.a](t.dataset.v)});
document.addEventListener('input',e=>{if(e.target.dataset&&e.target.dataset.n!==undefined){S.name=e.target.value.replace(/[<>&"']/g,'').slice(0,12)||'Jogador';save()}});

/* ===== ARRANQUE ===== */
let lt=performance.now(),T=0;qs();
function loop(now){requestAnimationFrame(loop);const dt=Math.min(.05,(now-lt)/1000);lt=now;T+=dt;
 if(state=='menu')menuTick(dt);else if(state=='count'||state=='race')tick(dt);
 pup(dt);RD.render(sc,cam)}
home();requestAnimationFrame(loop);
})();
</script></body></html>
